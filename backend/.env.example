GEMINI_API_KEY=
# Exact model ID as listed in Google AI Studio for Gemini 3.8 Flash
GEMINI_MODEL=gemini-3.8-flash
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_USERNAME=
CORS_ORIGINS=["http://localhost:5173"]

# Optional: tokens for private repositories on other git hosts (JSON: host -> token)
# GIT_HOST_TOKENS={"gitlab.com":"glpat-xxxx","git.mycompany.com":"xxxx"}
